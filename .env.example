# Public site URL (canonical URLs, sitemap, Open Graph). No trailing slash.
NEXT_PUBLIC_SITE_URL=https://www.richwestipl.sg

# Lead storage: the contact form writes to the existing Supabase `leads` table,
# and consented analytics events go to `analytics_events`. Server-only, never exposed to the browser.
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Optional: use the service role key instead of the anon key (bypasses RLS; keep secret).
# SUPABASE_SERVICE_ROLE_KEY=

# Optional: also POST each enquiry as JSON to a webhook (Zapier, Make, n8n, Slack, etc).
# CONTACT_WEBHOOK_URL=

# Tracking IDs (defaults match the current live site).
# NEXT_PUBLIC_GA_ID=G-TG7ED64M9P
# NEXT_PUBLIC_GTM_ID=GTM-TVVJ8VGD
# NEXT_PUBLIC_ADS_CONVERSION=AW-17511777226/eABaCILkkYkcEMqHop5B
# NEXT_PUBLIC_META_PIXEL_ID=1402613441524404
